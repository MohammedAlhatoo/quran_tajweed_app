rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // The role and the scope of an account come from its users document. Only
    // an active account holds a role.
    function hasRole(role) {
      return signedIn()
        && ownUser().role == role
        && ownUser().isActive == true;
    }

    // The General Admin manages the whole system.
    function isGeneralAdmin() {
      return hasRole('general_admin');
    }

    // An active region officer of [regionId].
    function isOfficerOf(regionId) {
      return hasRole('region_officer')
        && ownUser().regionId is string
        && ownUser().regionId == regionId;
    }

    // The General Admin, or the officer of [regionId].
    function managesRegion(regionId) {
      return isGeneralAdmin() || isOfficerOf(regionId);
    }

    // A suspended student keeps reading their own records but writes nothing.
    function isActiveStudent() {
      return hasRole('student');
    }

    // An active square supervisor who is assigned to a square. A supervisor
    // without a square reaches no square or examination data.
    function isAssignedSupervisor() {
      return hasRole('square_supervisor')
        && ownUser().squareId is string;
    }

    // An active square supervisor reviewing the examinations of [squareId].
    function isSupervisorOf(squareId) {
      return isAssignedSupervisor()
        && ownUser().squareId == squareId;
    }

    // The account [uid] as it is once the current batch is applied.
    function userDataAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }

    function awaitingReview(status) {
      return status in ['submitted', 'pending_review', 'under_review'];
    }

    function examData(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data;
    }

    function mosqueData(mosqueId) {
      return get(/databases/$(database)/documents/mosques/$(mosqueId)).data;
    }

    // The mosque as it is once the current batch is applied.
    function mosqueDataAfter(mosqueId) {
      return getAfter(/databases/$(database)/documents/mosques/$(mosqueId)).data;
    }

    function squareData(squareId) {
      return get(/databases/$(database)/documents/squares/$(squareId)).data;
    }

    function regionExists(regionId) {
      return exists(/databases/$(database)/documents/regions/$(regionId));
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    function validAddress(address) {
      return address is string && address.size() <= 500;
    }

    // The account recorded on a unit ([field] is officerId or supervisorId)
    // is cleared, left as it was, or set to an account that holds [role] over
    // that unit ([scopeField] is regionId or squareId) once the batch is
    // applied. Access never depends on this field; the users document decides.
    function validUnitLink(field, role, scopeField, unitId) {
      let linked = request.resource.data.get(field, null);
      return linked == null
        || linked == resource.data.get(field, null)
        || (linked is string
          && userDataAfter(linked).role == role
          && userDataAfter(linked)[scopeField] == unitId);
    }

    // Regions are managed by the General Admin only. An officer reads their
    // own region. Nothing is deleted; a region is deactivated instead.
    match /regions/{regionId} {
      allow read: if isGeneralAdmin() || isOfficerOf(regionId);

      allow create: if isGeneralAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'officerId', 'isActive', 'createdAt',
          'updatedAt'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('officerId', null) == null
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isGeneralAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'officerId', 'isActive', 'updatedAt'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.get('description', '') is string
        && validUnitLink('officerId', 'region_officer', 'regionId', regionId)
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Squares are managed by the General Admin and by the officer of their
    // region. A square never moves to another region. An officer's queries
    // must filter on regionId.
    match /squares/{squareId} {
      allow read: if managesRegion(resource.data.regionId)
        || isSupervisorOf(squareId);

      allow create: if managesRegion(request.resource.data.regionId)
        && request.resource.data.keys().hasOnly([
          'name', 'regionId', 'supervisorId', 'isActive', 'createdAt',
          'updatedAt'
        ])
        && regionExists(request.resource.data.regionId)
        && validName(request.resource.data.name)
        && request.resource.data.get('supervisorId', null) == null
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if managesRegion(resource.data.regionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'supervisorId', 'isActive', 'updatedAt'
        ])
        && validName(request.resource.data.name)
        && validUnitLink('supervisorId', 'square_supervisor', 'squareId', squareId)
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Active mosques are readable before sign-in so a student can choose one
    // during registration. Queries must filter on isActive == true.
    match /mosques/{mosqueId} {
      allow read: if resource.data.isActive == true;

      // An officer's queries must filter on regionId.
      allow read: if managesRegion(resource.data.regionId);

      // A mosque belongs to a square of its region.
      allow create: if managesRegion(request.resource.data.regionId)
        && request.resource.data.keys().hasOnly([
          'name', 'address', 'squareId', 'regionId', 'isActive', 'createdAt',
          'updatedAt'
        ])
        && validName(request.resource.data.name)
        && validAddress(request.resource.data.get('address', ''))
        && request.resource.data.isActive is bool
        && request.resource.data.squareId is string
        && squareData(request.resource.data.squareId).regionId
          == request.resource.data.regionId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Moving a mosque needs authority over both the region it leaves and
      // the region it joins, so an officer cannot move one out of the region.
      // A square supervisor never creates or moves a mosque. Not enforced
      // here: that the students of the mosque move in the same batch.
      allow update: if managesRegion(resource.data.regionId)
        && managesRegion(request.resource.data.regionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'address', 'squareId', 'regionId', 'isActive', 'updatedAt'
        ])
        && validName(request.resource.data.name)
        && validAddress(request.resource.data.get('address', ''))
        && request.resource.data.isActive is bool
        && request.resource.data.squareId is string
        && squareData(request.resource.data.squareId).regionId
          == request.resource.data.regionId
        && request.resource.data.updatedAt == request.time;
    }

    // Course content is readable by any signed-in user.
    match /courses/{courseId} {
      allow read: if signedIn();
    }

    match /course_rules/{courseRuleId} {
      allow read: if signedIn();
    }

    match /tajweed_rules/{ruleId} {
      allow read: if signedIn();
    }

    match /exam_segments/{segmentId} {
      allow read: if signedIn();
    }

    // Questions never hold the correct answer; see question_answers.
    match /question_bank/{questionId} {
      allow read: if signedIn();
    }

    // Correct answers. Students never read them, and nobody lists them. An
    // active supervisor assigned to a square reads one at a time to grade the
    // theory answers of a submitted examination. Not enforced here: that the
    // question belongs to an examination of the supervisor's square.
    match /question_answers/{questionId} {
      allow get: if isAssignedSupervisor();
    }

    match /exams/{examId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      // Queries must filter on squareId.
      allow read: if isSupervisorOf(resource.data.squareId);

      // An examination keeps the region it was started in. An officer's
      // queries must filter on regionId.
      allow read: if managesRegion(resource.data.regionId);

      // A student starts an examination for themselves. The affiliation must
      // match the student's account, and the course and segment must be
      // active and linked. Not enforced here: the random choice of the
      // segment, and the limit of one open examination per course.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'studentId', 'courseId', 'segmentId', 'status', 'mosqueId',
          'squareId', 'regionId', 'startedAt', 'submittedAt', 'reviewedAt',
          'approvedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'courseId', 'segmentId', 'status', 'mosqueId',
          'squareId', 'regionId', 'startedAt', 'submittedAt', 'reviewedAt',
          'approvedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.startedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.approvedAt == null
        && ownUser().role == 'student'
        && ownUser().isActive == true
        && request.resource.data.mosqueId is string
        && request.resource.data.squareId is string
        && request.resource.data.regionId is string
        && request.resource.data.mosqueId == ownUser().mosqueId
        && request.resource.data.squareId == ownUser().squareId
        && request.resource.data.regionId == ownUser().regionId
        && request.resource.data.courseId is string
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.isActive == true
        && request.resource.data.segmentId is string
        && get(/databases/$(database)/documents/exam_segments/$(request.resource.data.segmentId)).data.isActive == true
        && request.resource.data.courseId in get(/databases/$(database)/documents/exam_segments/$(request.resource.data.segmentId)).data.courseIds;

      // The student submits the examination: only the status and the two
      // timestamps change, in the same batch that creates the submission.
      // The mosque, square and region the examination was started in never
      // change, whoever writes.
      allow update: if isActiveStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'pending_review'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/submissions/$(examId));

      // The supervisor approves the result: only the status and the
      // timestamps change, in the same batch that creates the evaluation.
      allow update: if isSupervisorOf(resource.data.squareId)
        && awaitingReview(resource.data.status)
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'approvedAt', 'updatedAt'
        ])
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/evaluations/$(examId));
    }

    // One Tajweed error of an evaluation: {id, ruleId, ruleName, ayahNumber,
    // word, description, createdAt}. Only the reference to the rule is
    // checked: a request may evaluate at most 1000 expressions, which the
    // full check of four errors already reaches. Not enforced here: the other
    // fields, that ruleId matches a tajweed_rules record, and that ayahNumber
    // is inside the examination's segment. The app skips an error it cannot
    // read.
    function validDetailedError(error) {
      return error.ruleId is string;
    }

    // At most twenty errors, the limit the app applies. Rules cannot loop, so
    // each position is checked.
    function validDetailedErrors(errors) {
      return errors is list
        && errors.size() <= 20
        && (errors.size() < 1 || validDetailedError(errors[0]))
        && (errors.size() < 2 || validDetailedError(errors[1]))
        && (errors.size() < 3 || validDetailedError(errors[2]))
        && (errors.size() < 4 || validDetailedError(errors[3]))
        && (errors.size() < 5 || validDetailedError(errors[4]))
        && (errors.size() < 6 || validDetailedError(errors[5]))
        && (errors.size() < 7 || validDetailedError(errors[6]))
        && (errors.size() < 8 || validDetailedError(errors[7]))
        && (errors.size() < 9 || validDetailedError(errors[8]))
        && (errors.size() < 10 || validDetailedError(errors[9]))
        && (errors.size() < 11 || validDetailedError(errors[10]))
        && (errors.size() < 12 || validDetailedError(errors[11]))
        && (errors.size() < 13 || validDetailedError(errors[12]))
        && (errors.size() < 14 || validDetailedError(errors[13]))
        && (errors.size() < 15 || validDetailedError(errors[14]))
        && (errors.size() < 16 || validDetailedError(errors[15]))
        && (errors.size() < 17 || validDetailedError(errors[16]))
        && (errors.size() < 18 || validDetailedError(errors[17]))
        && (errors.size() < 19 || validDetailedError(errors[18]))
        && (errors.size() < 20 || validDetailedError(errors[19]));
    }

    // One evaluation per examination, with the examination's ID, created when
    // the supervisor approves the result with the notes and the Tajweed
    // errors. It is never changed afterwards. Not enforced here: that
    // theoryScore matches the student's answers and question_answers.
    match /evaluations/{evaluationId} {
      allow get: if isSupervisorOf(examData(evaluationId).squareId);

      // The student reads the evaluation of their own examination. It exists
      // only once the result is approved.
      allow get: if signedIn()
        && examData(evaluationId).studentId == request.auth.uid;

      allow get: if managesRegion(examData(evaluationId).regionId);

      allow create: if isSupervisorOf(examData(evaluationId).squareId)
        && awaitingReview(examData(evaluationId).status)
        && request.resource.data.keys().hasAll([
          'examId', 'supervisorId', 'recitationScore', 'theoryScore',
          'finalScore', 'result', 'feedback', 'detailedErrors', 'status',
          'reviewedAt', 'approvedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'examId', 'supervisorId', 'recitationScore', 'theoryScore',
          'finalScore', 'result', 'feedback', 'detailedErrors', 'status',
          'reviewedAt', 'approvedAt'
        ])
        && request.resource.data.examId == evaluationId
        && request.resource.data.supervisorId == request.auth.uid
        && request.resource.data.recitationScore is int
        && request.resource.data.recitationScore >= 0
        && request.resource.data.recitationScore <= 80
        && request.resource.data.theoryScore is int
        && request.resource.data.theoryScore >= 0
        && request.resource.data.theoryScore <= 20
        && request.resource.data.finalScore
          == request.resource.data.recitationScore + request.resource.data.theoryScore
        && request.resource.data.result
          == (request.resource.data.finalScore >= 70 ? 'passed' : 'failed')
        && (request.resource.data.feedback == null
          || (request.resource.data.feedback is string
            && request.resource.data.feedback.size() <= 2000))
        && validDetailedErrors(request.resource.data.detailedErrors)
        && request.resource.data.status == 'approved'
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.approvedAt == request.time
        && getAfter(/databases/$(database)/documents/exams/$(evaluationId)).data.status == 'approved';
    }

    // One certificate per passed examination, with the examination's ID. The
    // supervisor creates it in the batch that approves the result; nobody
    // changes or deletes it, and a student cannot create one.
    match /certificates/{certificateId} {
      // A student's queries must filter on studentId.
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      allow get: if isSupervisorOf(examData(certificateId).squareId)
        || managesRegion(examData(certificateId).regionId);

      allow create: if isSupervisorOf(examData(certificateId).squareId)
        && awaitingReview(examData(certificateId).status)
        && request.resource.data.keys().hasAll([
          'studentId', 'examId', 'courseId', 'certificateNumber', 'finalScore',
          'issuedAt', 'fileUrl'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'examId', 'courseId', 'certificateNumber', 'finalScore',
          'issuedAt', 'fileUrl'
        ])
        && request.resource.data.examId == certificateId
        && request.resource.data.studentId == examData(certificateId).studentId
        && request.resource.data.courseId == examData(certificateId).courseId
        && request.resource.data.certificateNumber is string
        && request.resource.data.certificateNumber.size() > 0
        && request.resource.data.certificateNumber.size() <= 40
        && request.resource.data.fileUrl == null
        && request.resource.data.issuedAt == request.time
        // Only for the evaluation written in this batch, and only if passed.
        && getAfter(/databases/$(database)/documents/evaluations/$(certificateId)).data.result == 'passed'
        && request.resource.data.finalScore
          == getAfter(/databases/$(database)/documents/evaluations/$(certificateId)).data.finalScore;
    }

    // A notification is addressed either to one account (userId) or to the
    // supervisor of a square (squareId). It is written in the batch of the
    // event it reports, and afterwards only marked as read.
    match /notifications/{notificationId} {
      // Queries must filter on userId, or on squareId for a supervisor.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow read: if isSupervisorOf(resource.data.squareId);

      allow update: if ((signedIn() && resource.data.userId == request.auth.uid)
          || isSupervisorOf(resource.data.squareId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;

      // The student tells the supervisor of the examination's square that an
      // examination was submitted, in the batch that submits it.
      allow create: if isActiveStudent()
        && validNotification()
        && request.resource.data.type == 'exam_submitted'
        && notificationId == request.resource.data.relatedId + '_submitted'
        && request.resource.data.userId == null
        && request.resource.data.squareId
          == examData(request.resource.data.relatedId).squareId
        && examData(request.resource.data.relatedId).studentId == request.auth.uid
        && examData(request.resource.data.relatedId).status == 'in_progress'
        && getAfter(/databases/$(database)/documents/exams/$(request.resource.data.relatedId)).data.status == 'pending_review';

      // The supervisor tells the student that the result was approved, in the
      // batch that approves it.
      allow create: if validNotification()
        && request.resource.data.type == 'exam_approved'
        && notificationId == request.resource.data.relatedId + '_result'
        && request.resource.data.squareId == null
        && request.resource.data.userId
          == examData(request.resource.data.relatedId).studentId
        && isSupervisorOf(examData(request.resource.data.relatedId).squareId)
        && awaitingReview(examData(request.resource.data.relatedId).status)
        && getAfter(/databases/$(database)/documents/exams/$(request.resource.data.relatedId)).data.status == 'approved';
    }

    function validNotification() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'squareId', 'title', 'body', 'type', 'relatedId', 'isRead',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'squareId', 'title', 'body', 'type', 'relatedId', 'isRead',
          'createdAt'
        ])
        && data.title is string
        && data.title.size() <= 200
        && data.body is string
        && data.body.size() <= 500
        && data.relatedId is string
        && data.isRead == false
        && data.createdAt == request.time;
    }

    // One answer of a submission: {order, questionId, answer}.
    function validAnswer(answer) {
      return answer is map
        && answer.keys().hasAll(['order', 'questionId', 'answer'])
        && answer.keys().hasOnly(['order', 'questionId', 'answer'])
        && answer.order is int
        && answer.order >= 1
        && answer.order <= 10
        && answer.questionId is string
        && answer.answer is string
        && answer.answer.size() <= 500;
    }

    // One submission per examination, with the examination's ID. It is never
    // changed after it is created. Not enforced here: that the recording
    // exists in Storage, and that the answers match the examination's
    // questions.
    match /submissions/{submissionId} {
      // A student's queries must filter on studentId.
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      allow get: if isSupervisorOf(examData(submissionId).squareId);

      allow create: if isActiveStudent()
        && request.resource.data.keys().hasAll([
          'examId', 'studentId', 'recordingUrl', 'answers', 'submittedAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'examId', 'studentId', 'recordingUrl', 'answers', 'submittedAt',
          'createdAt'
        ])
        && request.resource.data.examId == submissionId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.recordingUrl
          == 'exam_recordings/' + submissionId + '/recitation.m4a'
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 10
        && validAnswer(request.resource.data.answers[0])
        && validAnswer(request.resource.data.answers[1])
        && validAnswer(request.resource.data.answers[2])
        && validAnswer(request.resource.data.answers[3])
        && validAnswer(request.resource.data.answers[4])
        && validAnswer(request.resource.data.answers[5])
        && validAnswer(request.resource.data.answers[6])
        && validAnswer(request.resource.data.answers[7])
        && validAnswer(request.resource.data.answers[8])
        && validAnswer(request.resource.data.answers[9])
        && request.resource.data.submittedAt == request.time
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/exams/$(submissionId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/exams/$(submissionId)).data.status == 'in_progress'
        && getAfter(/databases/$(database)/documents/exams/$(submissionId)).data.status == 'pending_review';
    }

    match /exam_questions/{examQuestionId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      // One record at a time, by ID.
      allow get: if isSupervisorOf(examData(resource.data.examId).squareId);

      // Written by the student for their own open examination, and never
      // changed afterwards. The account's role is checked on the examination
      // itself, to keep the batch within the document access limit. Not
      // enforced here: that the question is a copy of an active question_bank
      // question of the course.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'examId', 'studentId', 'questionId', 'order', 'type', 'question',
          'options'
        ])
        && request.resource.data.keys().hasOnly([
          'examId', 'studentId', 'questionId', 'order', 'type', 'question',
          'options'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.order is int
        && request.resource.data.order >= 1
        && request.resource.data.order <= 10
        && examQuestionId == request.resource.data.examId + '_' + string(request.resource.data.order)
        && request.resource.data.questionId is string
        && request.resource.data.question is string
        && request.resource.data.options is list
        && getAfter(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.studentId == request.auth.uid
        && getAfter(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.status == 'in_progress';
    }

    // The fields every users document holds.
    function hasAccountKeys() {
      return request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'phone', 'role', 'regionId', 'squareId',
          'mosqueId', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'role', 'regionId', 'squareId',
          'mosqueId', 'isActive', 'createdAt', 'updatedAt'
        ]);
    }

    // Who may give an administrative account its scope: the General Admin
    // links a region officer to a region; the General Admin or the officer of
    // the region links a square supervisor to a square of that region.
    function validStaffScope(role, data) {
      return data.regionId is string
        && ((role == 'region_officer'
            && isGeneralAdmin()
            && data.squareId == null
            && regionExists(data.regionId))
          || (role == 'square_supervisor'
            && managesRegion(data.regionId)
            && (data.squareId == null
              || squareData(data.squareId).regionId == data.regionId)));
    }

    function inviteData(uid) {
      return get(/databases/$(database)/documents/staff_invites/$(uid)).data;
    }

    // An administrator invites an existing Firebase Authentication account,
    // named by its UID, to a role and a scope the administrator manages. The
    // invited account then creates its own users document from it. An
    // invitation holds no password and is never changed; the administrator
    // who wrote it can delete it while it is unused.
    match /staff_invites/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || managesRegion(resource.data.regionId));

      allow create: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'role', 'regionId', 'squareId',
          'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'role', 'regionId', 'squareId',
          'createdBy', 'createdAt'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(uid))
        && validStaffScope(request.resource.data.role, request.resource.data);

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(uid));
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;

      // A supervisor reads the students of their square. Queries must filter
      // on role and squareId.
      allow read: if resource.data.role == 'student'
        && isSupervisorOf(resource.data.squareId);

      // An officer reads the accounts of their region; queries must filter on
      // regionId. The General Admin reads every account.
      allow read: if managesRegion(resource.data.regionId);

      // Self-registration always creates an active student whose square and
      // region come from the chosen mosque.
      allow create: if signedIn()
        && request.auth.uid == uid
        && hasAccountKeys()
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.isActive == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.mosqueId is string
        && mosqueData(request.resource.data.mosqueId).isActive == true
        && request.resource.data.squareId
          == mosqueData(request.resource.data.mosqueId).squareId
        && request.resource.data.regionId
          == mosqueData(request.resource.data.mosqueId).regionId;

      // An administrative account writes its own users document, so the
      // document always belongs to a Firebase Authentication account. It must
      // repeat the invitation an administrator wrote for this UID, which is
      // where the role and the scope were authorized. Nobody can write an
      // administrative users document for another UID, and a General Admin
      // is never created here.
      allow create: if signedIn()
        && request.auth.uid == uid
        && hasAccountKeys()
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['region_officer', 'square_supervisor']
        && request.resource.data.mosqueId == null
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.role == inviteData(uid).role
        && request.resource.data.name == inviteData(uid).name
        && request.resource.data.email == inviteData(uid).email
        && request.resource.data.phone == inviteData(uid).phone
        && request.resource.data.regionId == inviteData(uid).regionId
        && request.resource.data.squareId == inviteData(uid).squareId;

      // Nobody changes their own account, and the role, the email and the
      // mosque of an account never change. A General Admin account is never
      // changed from the application. A student keeps the square and region
      // of their mosque, so those change only when the mosque itself moves:
      // the mosque is read as it is after the write, which lets the mosque
      // and its students move in one batch.
      allow update: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'isActive', 'regionId', 'squareId', 'updatedAt'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt == request.time
        && ((resource.data.role in ['region_officer', 'square_supervisor']
            && (resource.data.role == 'region_officer'
              || managesRegion(resource.data.regionId))
            && validStaffScope(resource.data.role, request.resource.data))
          || (resource.data.role == 'student'
            && managesRegion(resource.data.regionId)
            && managesRegion(request.resource.data.regionId)
            && request.resource.data.squareId
              == mosqueDataAfter(resource.data.mosqueId).squareId
            && request.resource.data.regionId
              == mosqueDataAfter(resource.data.mosqueId).regionId));
    }
  }
}
