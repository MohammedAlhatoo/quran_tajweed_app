rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /students/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'phone', 'email', 'createdAt', 'status'
        ]);
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Active mosques are readable before sign-in so a student can choose one
    // during registration. Queries must filter on isActive == true.
    match /mosques/{mosqueId} {
      allow read: if resource.data.isActive == true;
    }

    // Course content is readable by any signed-in user.
    match /courses/{courseId} {
      allow read: if signedIn();
    }

    match /course_rules/{courseRuleId} {
      allow read: if signedIn();
    }

    match /tajweed_rules/{ruleId} {
      allow read: if signedIn();
    }

    match /exam_segments/{segmentId} {
      allow read: if signedIn();
    }

    // Questions never hold the correct answer; see question_answers.
    match /question_bank/{questionId} {
      allow read: if signedIn();
    }

    // Correct answers. No client access.
    match /question_answers/{questionId} {
      allow read, write: if false;
    }

    function ownUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /exams/{examId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      // A student starts an examination for themselves. The affiliation must
      // match the student's account, and the course and segment must be
      // active and linked. Not enforced here: the random choice of the
      // segment, and the limit of one open examination per course.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'studentId', 'courseId', 'segmentId', 'status', 'mosqueId',
          'squareId', 'regionId', 'startedAt', 'submittedAt', 'reviewedAt',
          'approvedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'courseId', 'segmentId', 'status', 'mosqueId',
          'squareId', 'regionId', 'startedAt', 'submittedAt', 'reviewedAt',
          'approvedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.startedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.approvedAt == null
        && ownUser().role == 'student'
        && ownUser().isActive == true
        && request.resource.data.mosqueId == ownUser().mosqueId
        && request.resource.data.squareId == ownUser().squareId
        && request.resource.data.regionId == ownUser().regionId
        && request.resource.data.courseId is string
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.isActive == true
        && request.resource.data.segmentId is string
        && get(/databases/$(database)/documents/exam_segments/$(request.resource.data.segmentId)).data.isActive == true
        && request.resource.data.courseId in get(/databases/$(database)/documents/exam_segments/$(request.resource.data.segmentId)).data.courseIds;

      // The student submits the examination: only the status and the two
      // timestamps change, in the same batch that creates the submission.
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'pending_review'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/submissions/$(examId));
    }

    // One submission per examination, with the examination's ID. It is never
    // changed after it is created. Not enforced here: that the recording
    // exists in Storage, and that the answers match the examination's
    // questions.
    match /submissions/{submissionId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'examId', 'studentId', 'recordingUrl', 'answers', 'submittedAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'examId', 'studentId', 'recordingUrl', 'answers', 'submittedAt',
          'createdAt'
        ])
        && request.resource.data.examId == submissionId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.recordingUrl
          == 'exam_recordings/' + submissionId + '/recitation.m4a'
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 10
        && request.resource.data.submittedAt == request.time
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/exams/$(submissionId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/exams/$(submissionId)).data.status == 'in_progress'
        && getAfter(/databases/$(database)/documents/exams/$(submissionId)).data.status == 'pending_review';
    }

    match /exam_questions/{examQuestionId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;

      // Written together with the examination, in the same batch.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'examId', 'studentId', 'questionId', 'order', 'type', 'question',
          'options'
        ])
        && request.resource.data.keys().hasOnly([
          'examId', 'studentId', 'questionId', 'order', 'type', 'question',
          'options'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.order is int
        && request.resource.data.order >= 1
        && request.resource.data.order <= 10
        && examQuestionId == request.resource.data.examId + '_' + string(request.resource.data.order)
        && request.resource.data.questionId is string
        && request.resource.data.question is string
        && request.resource.data.options is list
        && getAfter(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.studentId == request.auth.uid
        && getAfter(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.status == 'in_progress';
    }

    function mosqueData(mosqueId) {
      return get(/databases/$(database)/documents/mosques/$(mosqueId)).data;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;

      // Self-registration always creates an active student whose square and
      // region come from the chosen mosque.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'phone', 'role', 'regionId', 'squareId',
          'mosqueId', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'role', 'regionId', 'squareId',
          'mosqueId', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.isActive == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.mosqueId is string
        && mosqueData(request.resource.data.mosqueId).isActive == true
        && request.resource.data.squareId
          == mosqueData(request.resource.data.mosqueId).squareId
        && request.resource.data.regionId
          == mosqueData(request.resource.data.mosqueId).regionId;
    }
  }
}
