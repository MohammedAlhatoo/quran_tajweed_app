rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function examData(examId) {
      return firestore.get(/databases/(default)/documents/exams/$(examId)).data;
    }

    function ownUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Only an active account holds a role.
    function hasRole(role) {
      return signedIn()
        && ownUser().role == role
        && ownUser().isActive == true;
    }

    // One recitation recording per examination. Re-recording overwrites it.
    match /exam_recordings/{examId}/recitation.m4a {
      allow read: if signedIn()
        && examData(examId).studentId == request.auth.uid;

      // An active square supervisor listens to the recordings of the square
      // the examination was started in, once it is submitted. A supervisor
      // without a square, or of another square, reads nothing.
      allow read: if hasRole('square_supervisor')
        && ownUser().squareId is string
        && ownUser().squareId == examData(examId).squareId
        && examData(examId).status != 'in_progress';

      // The officer of the examination's region, and the General Admin, once
      // it is submitted.
      allow read: if (hasRole('general_admin')
          || (hasRole('region_officer')
            && ownUser().regionId is string
            && ownUser().regionId == examData(examId).regionId))
        && examData(examId).status != 'in_progress';

      // Only the examination's student, while the account is active, and only
      // until the examination is submitted. Nobody deletes a recording.
      allow create, update: if hasRole('student')
        && examData(examId).studentId == request.auth.uid
        && examData(examId).status == 'in_progress'
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'audio/mp4';
    }
  }
}
